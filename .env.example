# OAuth 2.1 authorization server and MCP resource-server configuration.
# All production URLs must be HTTPS. Never commit real tokens or credentials.
NEYVRO_MCP_OAUTH_ISSUER=
NEYVRO_MCP_OAUTH_AUDIENCE=
NEYVRO_MCP_OAUTH_JWKS_URL=
NEYVRO_MCP_RESOURCE_URL=https://your-mcp-host.example/mcp
NEYVRO_MCP_ALLOWED_HOSTS=your-mcp-host.example

# AWS MCP bridge. Keep false until the isolated staging checks in the contract
# pass. Never configure a static backend bearer token.
NEYVRO_MCP_BRIDGE_ENABLED=false
NEYVRO_MCP_API_BASE_URL=
NEYVRO_MCP_ALLOWED_API_HOSTS=
NEYVRO_MCP_GATEWAY_PRIVATE_KEY=
NEYVRO_MCP_GATEWAY_KEY_ID=gw-test-1
NEYVRO_MCP_FIREBASE_PROJECT_ID=
NEYVRO_MCP_FIREBASE_SERVICE_ACCOUNT_JSON=
NEYVRO_MCP_CLIENT_NAME=neyvro-render
NEYVRO_MCP_BACKEND_TIMEOUT_SECONDS=10
NEYVRO_MCP_REQUESTS_PER_MINUTE=60
NEYVRO_MCP_PUBLIC_REQUESTS_PER_MINUTE=30
